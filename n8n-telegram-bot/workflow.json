    {
      "parameters": {
        "jsCode": "// Build one publish item per selected platform.\n// Matches brand -> connection with substring/handle logic (mirrors lib.js).\nconst norm = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9 ]/g, ' ').replace(/\\s+/g, ' ').trim();\nconst sess = $('Callback: Handle').first().json;\nconst brand = sess.brand || '';\nconst selected = sess.selected || [];\nconst caps = $('Gen Captions (Grok)').first().json?.captions || {};\nconst conns = $input.first().json;\nconst list = Array.isArray(conns) ? conns : [];\nconst nb = norm(brand);\nconst score = (label) => {\n  const a = norm(label);\n  if (!a || !nb) return 0;\n  if (a.includes(nb) && nb.length > 3) return 100;\n  if (nb.includes(a) && a.length > 3) return 100;\n  if (a.replace(/ /g, '') === nb.replace(/ /g, '') && nb.length > 3) return 90;\n  const ta = new Set(a.split(' ').filter(t => t.length >= 3));\n  const tb = new Set(nb.split(' ').filter(t => t.length >= 3));\n  let s = 0; for (const t of ta) if (tb.has(t)) s += 10;\n  return s;\n};\nconst items = [];\nfor (const p of selected) {\n  const cands = list.filter(c => c.platform === p).map(c => ({ c, s: score(c.account_name) })).sort((x, y) => y.s - x.s);\n  const best = cands.length ? cands[0] : null;\n  if (!best || best.s < 10) {\n    items.push({ json: { platform: p, error: `No ${p} account matched brand \"${brand}\" — connect it in Driftpost first.`, chat_id: sess.chat_id, brand, selected } });\n    continue;\n  }\n  const yt = caps.youtube || {}, ig = caps.instagram || {}, fb = caps.facebook || {}, x = caps.x || {};\n  const tags = Array.isArray(yt.tags) ? yt.tags.join(',') : '';\n  const hash = Array.isArray(ig.hashtags) ? ig.hashtags.map(t => '#' + t).join(' ') : '';\n  const base = { platform: p, connection_id: best.c.id, account: best.c.account_name, chat_id: sess.chat_id, brand, selected };\n  if (p === 'youtube') Object.assign(base, { text: yt.description || ig.caption || '', yt_title: String(yt.title || brand).slice(0, 100), yt_description: yt.description || '', yt_tags: tags });\n  if (p === 'instagram') Object.assign(base, { text: ig.caption || '', ig_caption: [ig.caption, hash].filter(Boolean).join('\\n\\n') });\n  if (p === 'facebook') Object.assign(base, { text: fb.message || '', fb_message: fb.message || '' });\n  if (p === 'x') Object.assign(base, { text: String(x.text || ig.caption || '').slice(0, 280), x_text: String(x.text || '').slice(0, 280) });\n  items.push({ json: base });\n}\nif (!items.length) items.push({ json: { platform: 'none', error: 'Nothing selected', chat_id: sess.chat_id, brand, selected } });\nreturn items;"
      },
