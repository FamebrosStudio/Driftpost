    {
      "parameters": {
        "jsCode": "// Format one Telegram result line per platform item.\nconst items = $input.all();\nconst out = [];\nfor (const it of items) {\n  const j = it.json;\n  const chat_id = j.chat_id || $('Callback: Handle').first().json.chat_id;\n  if (j.error && !j.job) {\n    out.push({ json: { chat_id, text: `⚠️ *${j.platform}*: ${j.error}` } });\n    continue;\n  }\n  const job = j.job || {};\n  const plat = job.platform || j.platform || 'post';\n  if (job.state === 'completed') out.push({ json: { chat_id, text: `✅ *${plat}* published!\\n${job.url || ''}${job.warning ? '\\n_' + job.warning + '_' : ''}` } });\n  else if (job.state === 'failed') out.push({ json: { chat_id, text: `❌ *${plat}* failed: ${job.message || 'unknown error'}` } });\n  else out.push({ json: { chat_id, text: `⏳ *${plat}* still processing (job ${job.id || ''}). Check Driftpost History — it finishes server-side.` } });\n}\nreturn out;"
