    {
      "parameters": {
        "jsCode": "// Decide what a text message means.\nconst rows = $input.first().json;\nconst sess = Array.isArray(rows) ? rows[0] : rows;\nconst prev = $('Classify Update').first().json;\nconst text = (prev.text || '').trim();\nconst chat_id = prev.chat_id;\nconst kb = (sel) => {\n  const on = (s) => (sel || []).includes(s) ? '✅' : '⬜';\n  return { inline_keyboard: [[{ text: `${on('youtube')} YouTube`, callback_data: 'toggle:youtube' }, { text: `${on('instagram')} Instagram`, callback_data: 'toggle:instagram' }], [{ text: `${on('facebook')} Facebook`, callback_data: 'toggle:facebook' }, { text: `${on('x')} X`, callback_data: 'toggle:x' }], [{ text: '🚀 POST NOW', callback_data: 'done' }, { text: '❌ Cancel', callback_data: 'cancel' }]] };\n};\nif (/^\\/start/i.test(text)) {\n  return [{ json: { action: 'help', chat_id, text: '👋 *Driftpost Bot*\\n\\n1️⃣ Send a video (caption first line = brand)\\n2️⃣ Tap platforms (many allowed)\\n3️⃣ Press 🚀 POST NOW\\n\\nCaptions are auto-written with your brand voice, then posted to each platform.' } }];\n}\nif (sess && sess.status === 'awaiting_brand' && text && !text.startsWith('/')) {\n  return [{ json: { action: 'set_brand', chat_id, brand: text.slice(0, 120), selected: [], reply_markup: kb([]) } }];\n}\nif (!sess) {\n  return [{ json: { action: 'hint', chat_id, text: 'Send a video first — I will ask for platforms after that. 🎬' } }];\n}\nreturn [{ json: { action: 'hint', chat_id, text: `Already waiting on your video for *${sess.brand || 'unknown brand'}*. Tap the buttons above, then 🚀 POST NOW.` } }];"
      },
