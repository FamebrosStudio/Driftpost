    {
      "parameters": {
        "jsCode": "// Classify every Telegram update into one route.\nconst u = $input.first().json;\nconst msg = u.message || u.edited_message || null;\nconst cb = u.callback_query || null;\nlet route = 'other', chat_id = null, out = {};\nif (cb) {\n  route = 'callback';\n  chat_id = cb.message?.chat?.id || cb.from?.id;\n  out = { callback_id: cb.id, callback_data: cb.data || '', chat_id, message_id: cb.message?.message_id };\n} else if (msg) {\n  chat_id = msg.chat?.id;\n  const hasVideo = !!(msg.video || (msg.document && /video|mp4|mov|mkv|webm/i.test(msg.document.mime_type || '' + (msg.document.file_name || ''))));\n  const hasPhoto = !!(!hasVideo && (msg.photo || (msg.document && /image/i.test(msg.document.mime_type || ''))));\n  if (hasVideo || hasPhoto) {\n    route = 'video';\n    const media = msg.video || msg.document || (Array.isArray(msg.photo) ? msg.photo[msg.photo.length - 1] : null);\n    const caption = msg.caption || '';\n    const lines = String(caption).split('\\n').map(s => s.trim()).filter(Boolean);\n    out = {\n      chat_id,\n      file_id: media?.file_id || '',\n      file_unique_id: media?.file_unique_id || '',\n      kind: hasVideo ? 'video' : 'photo',\n      brand: lines.length ? lines[0].slice(0, 120) : '',\n      summary: lines.length > 1 ? lines.slice(1).join('\\n').slice(0, 400) : ''\n    };\n  } else if (msg.text) {\n    route = 'text';\n    out = { chat_id, text: String(msg.text || '').slice(0, 500) };\n  } else {\n    out = { chat_id };\n  }\n}\nreturn [{ json: { route, ...out } }];"
      },
