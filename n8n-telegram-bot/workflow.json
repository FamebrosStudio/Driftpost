    {
      "parameters": {
        "jsCode": "// Decide what to send after a video arrives.\nconst j = $input.first().json;\n// video-upsert returns the row (array) or echoes input; recover chat context:\nconst prev = $('Classify Update').first().json;\nconst chat_id = prev.chat_id;\nconst brand = (prev.brand || '').trim();\nconst hasBrand = !!brand;\nconst kb = (sel) => {\n  const on = (s) => (sel || []).includes(s) ? '✅' : '⬜';\n  return { inline_keyboard: [[{ text: `${on('youtube')} YouTube`, callback_data: 'toggle:youtube' }, { text: `${on('instagram')} Instagram`, callback_data: 'toggle:instagram' }], [{ text: `${on('facebook')} Facebook`, callback_data: 'toggle:facebook' }, { text: `${on('x')} X`, callback_data: 'toggle:x' }], [{ text: '🚀 POST NOW', callback_data: 'done' }, { text: '❌ Cancel', callback_data: 'cancel' }]] };\n};\nif (!hasBrand) {\n  return [{ json: {\n    send_kind: 'ask_brand', chat_id,\n    text: '🎬 Video received!\\n\\nWhich *brand* is this for? Reply with the brand name exactly as in Driftpost (e.g. Hair Match Salon).'\n  } }];\n}\nreturn [{ json: {\n  send_kind: 'picker', chat_id,\n  text: `🎬 Video received for *${brand}*!\\n\\nTap to select platforms (you can pick many), then press 🚀 POST NOW:`,\n  reply_markup: kb([])\n} }];"
      },
