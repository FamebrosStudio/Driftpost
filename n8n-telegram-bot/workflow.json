    {
      "parameters": {
        "jsCode": "// Toggle platform selection or resolve done/cancel.\nconst rows = $input.first().json;\nconst sess = Array.isArray(rows) ? rows[0] : rows;\nconst prev = $('Classify Update').first().json;\nconst data = prev.callback_data || '';\nconst chat_id = prev.chat_id;\nconst callback_id = prev.callback_id;\nconst message_id = prev.message_id;\nif (!sess) return [{ json: { action: 'stale', chat_id, callback_id, alert: 'Session expired — send the video again 🎬' } }];\nlet selected = Array.isArray(sess.selected) ? [...sess.selected] : [];\nif (data.startsWith('toggle:')) {\n  const p = data.split(':')[1];\n  selected = selected.includes(p) ? selected.filter(x => x !== p) : [...selected, p];\n  return [{ json: { action: 'toggle', chat_id, callback_id, message_id, brand: sess.brand, summary: sess.summary, file_id: sess.file_id, selected } }];\n}\nif (data === 'done') {\n  if (!selected.length) return [{ json: { action: 'empty', chat_id, callback_id, alert: 'Pick at least 1 platform first ☝️' } }];\n  return [{ json: { action: 'done', chat_id, callback_id, message_id, brand: sess.brand, summary: sess.summary, file_id: sess.file_id, selected } }];\n}\nif (data === 'cancel') return [{ json: { action: 'cancel', chat_id, callback_id, message_id } }];\nreturn [{ json: { action: 'stale', chat_id, callback_id, alert: 'Unknown button' } }];"
      },
